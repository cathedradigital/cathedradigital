{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cathedradigital",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "routes": [
    {
      "pattern": "cathedradigital.com.br",
      "custom_domain": true
    },
    {
      "pattern": "www.cathedradigital.com.br",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
