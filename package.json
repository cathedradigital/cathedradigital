  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/check-deploy-assets.mjs && node scripts/validate-module-contracts.mjs && node scripts/validate-security-boundaries.mjs && node scripts/validate-e2e-security.mjs && vite build && tsc --noEmit",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test e2e/estudar-public-smoke.spec.ts e2e/sidebar-accessibility.spec.ts e2e/glossary-resilience.spec.ts --project=chromium --project=mobile-chrome",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "validate:modules": "node scripts/validate-module-contracts.mjs",
    "validate:links": "node scripts/validate-internal-routes.mjs",
    "validate:security": "node scripts/validate-security-boundaries.mjs && node scripts/validate-e2e-security.mjs",
    "deploy:cloudflare": "npm run build && npx wrangler deploy",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && npx wrangler deploy"
  },
